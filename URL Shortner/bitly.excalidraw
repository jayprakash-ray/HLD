      "updated": 1776400742222,
      "link": null,
      "locked": false,
      "text": "Functional Requirement:\n    1. User shaould be able to get a short url for given long url\n        - can give alias / custom\n        - can have expiration time\n        - unique\n    2. User should be able to redirect to long url when using shorturl\n  ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Functional Requirement:\n    1. User shaould be able to get a short url for given long url\n        - can give alias / custom\n        - can have expiration time\n        - unique\n    2. User should be able to redirect to long url when using shorturl\n  ",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "C2sYpdqycmWr_Cd08XvJ0",
      "type": "text",
      "x": 100.66647338867188,
      "y": 461.28570556640625,
      "width": 639.319580078125,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a1",
