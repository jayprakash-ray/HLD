    {
      "id": "9JbczL89sXJa-4F99UiLP",
      "type": "text",
      "x": 931.5998483879836,
      "y": 1231.423095078823,
      "width": 2124.296875,
      "height": 54,
      "angle": 0.00757508536543039,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
