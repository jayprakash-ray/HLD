      "seed": 1302684562,
      "version": 51,
      "versionNonce": 2008480530,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1771782086779,
      "link": null,
      "locked": false,
      "text": "“TTL expiration must be enforced inside the cache node because it owns the data and eviction\npolicy. Centralizing TTL avoids clock skew issues and ensures consistent expiry behavior. The client\nshould remain a thin routing layer, not a stateful data manager.”",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "“TTL expiration must be enforced inside the cache node because it owns the data and eviction policy. Centralizing TTL avoids clock skew issues and ensures consistent expiry behavior. The client should remain a thin routing layer, not a stateful data manager.”",
      "autoResize": false,
      "lineHeight": 1.25
    },
