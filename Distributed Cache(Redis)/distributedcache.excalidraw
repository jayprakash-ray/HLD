    {
      "id": "E0iIA0xEpKWhACxsDUQo_",
      "type": "text",
      "x": 659.6932084491884,
      "y": 154.1211560149587,
      "width": 779.935302734375,
      "height": 60,
      "angle": 0,
      "strokeColor": "#1e1e1e",
