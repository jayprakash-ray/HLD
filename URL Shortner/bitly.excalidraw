      "index": "aO",
      "roundness": null,
      "seed": 1667497594,
      "version": 874,
      "versionNonce": 98044154,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1776503510227,
      "link": null,
      "locked": false,
      "text": "HTTP 301 - resource is moved parmanently to a new location , client should not attempt to request short url instead use result of GET url \nHTTP 302 - 302 (Found): This indicates that the resource is temporarily located at a different URL. HTTP 302 - Browsers do not cache this response, ensuring that future requests for the short URL will always go through our server first.",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "HTTP 301 - resource is moved parmanently to a new location , client should not attempt to request short url instead use result of GET url \nHTTP 302 - 302 (Found): This indicates that the resource is temporarily located at a different URL. HTTP 302 - Browsers do not cache this response, ensuring that future requests for the short URL will always go through our server first.",
      "autoResize": true,
      "lineHeight": 1.35
    },
