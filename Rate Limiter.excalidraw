    {
      "id": "ul-m5fAAbBWhmi1YNGAcD",
      "type": "text",
      "x": 2654.868826174946,
      "y": 1050.2794592306366,
      "width": 539,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1R",
      "roundness": null,
      "seed": 808484476,
      "version": 492,
      "versionNonce": 229620595,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1755293836137,
      "link": null,
      "locked": false,
      "text": "1. request come in\n2. gateway fetch token and last_refill_time from \nredis HMGET alice:bucket tokens last_refill\n3. Update counts based on rate and last refill\n4. Responsd pass or fail based on if tokens > 0\n5. Update bucket status",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. request come in\n2. gateway fetch token and last_refill_time from \nredis HMGET alice:bucket tokens last_refill\n3. Update counts based on rate and last refill\n4. Responsd pass or fail based on if tokens > 0\n5. Update bucket status",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "ukv8c60pRxB-Q9LhhcOMB",
      "type": "text",
      "x": 2650.3336516580684,
      "y": 1227.9044790558955,
      "width": 957,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1i",
      "roundness": null,
      "seed": 1783929028,
      "version": 399,
      "versionNonce": 967693587,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1755293836137,
      "link": null,
      "locked": false,
      "text": "X-RateLimit-Limit: The rate limit ceiling for that request (e.g., \"100\")\nX-RateLimit-Remaining: Number of requests left in the current window (e.g., \"0\")\nX-RateLimit-Reset: When the rate limit resets, as a Unix timestamp (e.g., \"1640995200\")",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "X-RateLimit-Limit: The rate limit ceiling for that request (e.g., \"100\")\nX-RateLimit-Remaining: Number of requests left in the current window (e.g., \"0\")\nX-RateLimit-Reset: When the rate limit resets, as a Unix timestamp (e.g., \"1640995200\")",
      "autoResize": true,
      "lineHeight": 1.25
    },
