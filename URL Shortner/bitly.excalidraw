    {
      "id": "DZllI43ySwnp4v2Zmd3OU",
      "type": "text",
      "x": 3161.8643206814745,
      "y": 191.12242930059847,
      "width": 492.059326171875,
      "height": 27,
      "angle": 0,
      "strokeColor": "#1e1e1e",
