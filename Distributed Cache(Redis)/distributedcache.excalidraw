      "link": null,
      "locked": false,
      "text": "3. APIs\n\nGET /cache/{key}\nPOST /Cache/{key}\n{\n    key : \"abc\"\n   value : \"Valu\",\n   TTL : 60s\n}\nGET : /cache/nodes\nPOST /cache/node -> add node\n\nGET /heath -> heartbeats",
      "fontSize": 16,
