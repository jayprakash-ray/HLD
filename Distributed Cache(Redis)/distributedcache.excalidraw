    {
      "id": "_3U4yBuKXkJ0NxGyNZMGl",
      "type": "text",
      "x": 567.4245687401238,
      "y": 933.774869183101,
      "width": 911.7965698242188,
      "height": 48.40113430822627,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b09",
      "roundness": null,
      "seed": 504155214,
      "version": 77,
      "versionNonce": 927691666,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1771781454525,
      "link": null,
      "locked": false,
      "text": "“Cache nodes send heartbeats to Zookeeper. If a primary fails, Zookeeper detects it and promotes a replica via leader election.\n Clients update their consistent hashing ring and start routing to the new primary.\n Since replication is async, we may lose a small amount of cache data, but that’s acceptable because the database remains the source of truth.”",
      "fontSize": 12.90696914886034,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "“Cache nodes send heartbeats to Zookeeper. If a primary fails, Zookeeper detects it and promotes a replica via leader election.\n Clients update their consistent hashing ring and start routing to the new primary.\n Since replication is async, we may lose a small amount of cache data, but that’s acceptable because the database remains the source of truth.”",
      "autoResize": true,
      "lineHeight": 1.25
    },
