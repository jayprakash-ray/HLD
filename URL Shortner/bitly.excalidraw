      "seed": 1498303098,
      "version": 299,
      "versionNonce": 1705134330,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1776400756336,
      "link": null,
      "locked": false,
      "text": "Non- Functional Requirement\n\n1. should support the scale of 100M DAU and 1B request in total\n2. should have low latency in accessing and writing urls\n3. Should be Highly Available >> consistency   (CAP)",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Non- Functional Requirement\n\n1. should support the scale of 100M DAU and 1B request in total\n2. should have low latency in accessing and writing urls\n3. Should be Highly Available >> consistency   (CAP)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "t0NH6wKvDUei81NO-wBD0",
      "type": "text",
      "x": 91.63067626953125,
      "y": 708.9642639160156,
      "width": 515.3997802734375,
      "height": 550,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a2",
      "roundness": null,
      "seed": 239184954,
      "version": 254,
      "versionNonce": 584172282,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1776501634938,
      "link": null,
      "locked": false,
      "text": "Core Entities\n\n1. User \n2. longURL\n3. shortURL\n\n\n\nAPI Endpoints:\n    \nPOST /urls         longUrl -> short\n{\n    longURl : \" \"\n    expirationTime: \n    customUrl : \n}\n\nGET /shortUrl -> redirect to long URL (HTTP 302)\n\n\n\n    ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Core Entities\n\n1. User \n2. longURL\n3. shortURL\n\n\n\nAPI Endpoints:\n    \nPOST /urls         longUrl -> short\n{\n    longURl : \" \"\n    expirationTime: \n    customUrl : \n}\n\nGET /shortUrl -> redirect to long URL (HTTP 302)\n\n\n\n    ",
      "autoResize": true,
      "lineHeight": 1.25
    },
